<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_ttt_arena"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0B1120"
    android:paddingHorizontal="18dp"
    android:paddingTop="14dp"
    android:paddingBottom="18dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btn_ttt_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="#F8FAFC"
            android:contentDescription="Leave game view" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tic Tac Toe"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#F8FAFC" />

            <TextView
                android:id="@+id/tv_ttt_round"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Round 1"
                android:textSize="12sp"
                android:textColor="#94A3B8" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_ttt_end_game"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingVertical="7dp"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="#EF4444"
            android:text="End Game"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- Player Scoreboard Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Player X Card -->
        <LinearLayout
            android:id="@+id/card_player_x"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_ttt_cell">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#38BDF8" />

            <TextView
                android:id="@+id/tv_x_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Player X"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F8FAFC"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_x_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#38BDF8" />
        </LinearLayout>

        <!-- Draws Column -->
        <LinearLayout
            android:layout_width="68dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingHorizontal="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#64748B" />

            <TextView
                android:id="@+id/tv_draws_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Draws\n0"
                android:textSize="12sp"
                android:textColor="#94A3B8" />
        </LinearLayout>

        <!-- Player O Card -->
        <LinearLayout
            android:id="@+id/card_player_o"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_ttt_cell">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="O"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FB7185" />

            <TextView
                android:id="@+id/tv_o_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Player O"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#F8FAFC"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_o_score"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FB7185" />
        </LinearLayout>
    </LinearLayout>

    <!-- Status Banner -->
    <LinearLayout
        android:id="@+id/layout_ttt_status_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="@drawable/bg_game_invite_card">

        <TextView
            android:id="@+id/tv_ttt_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting to arena..."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC" />

        <TextView
            android:id="@+id/tv_ttt_substatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Waiting for live sync"
            android:textSize="12sp"
            android:textColor="#94A3B8" />
    </LinearLayout>

    <!-- Centered 3x3 Board -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/grid_ttt_board"
            android:layout_width="306dp"
            android:layout_height="306dp"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <!-- Row 0 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_cell_0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ttt_cell"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_cell_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ttt_cell"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_cell_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ttt_cell"
                    android:textSize="44sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_cell_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ttt_cell"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_cell_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ttt_cell"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_cell_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ttt_cell"
                    android:textSize="44sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_cell_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ttt_cell"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_cell_7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ttt_cell"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_cell_8"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:background="@drawable/bg_ttt_cell"
                    android:textSize="44sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_ttt_rematch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="#10B981"
            android:text="Play Next Round"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_ttt_finish"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:backgroundTint="#1E293B"
            android:text="Back to Chat"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#F8FAFC" />
    </LinearLayout>

</LinearLayout>
