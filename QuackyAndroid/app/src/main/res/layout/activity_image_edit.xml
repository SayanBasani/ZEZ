<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- Top Action Toolbar -->
    <LinearLayout
        android:id="@+id/edit_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="#1E1E1E">

        <ImageButton
            android:id="@+id/btn_edit_cancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF"
            android:contentDescription="Cancel" />

        <TextView
            android:id="@+id/tv_edit_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Edit Image"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_save"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Save"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/primary"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>

    <!-- Main Canvas / Image Preview Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <ImageView
            android:id="@+id/iv_edit_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Edit preview" />

        <ProgressBar
            android:id="@+id/pb_edit_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

    </FrameLayout>

    <!-- Tool Options Panel (Transform / Adjust / Filters) -->
    <FrameLayout
        android:id="@+id/layout_tool_options"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="#1A1A1A">

        <!-- 1. Transform / Rotate / Flip Tools -->
        <LinearLayout
            android:id="@+id/panel_transform"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rotate_left"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:text="⟲ -90°"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#FFFFFF"
                android:strokeColor="#55FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_rotate_right"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:text="⟳ +90°"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#FFFFFF"
                android:strokeColor="#55FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_flip_h"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:text="⇄ Flip H"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#FFFFFF"
                android:strokeColor="#55FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_crop_square"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginHorizontal="6dp"
                android:text="1:1 Crop"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:textColor="#FFFFFF"
                android:strokeColor="#55FFFFFF" />

        </LinearLayout>

        <!-- 2. Sliders (Brightness / Contrast / Saturation) -->
        <LinearLayout
            android:id="@+id/panel_adjust"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:visibility="gone">

            <!-- Brightness -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="wrap_content"
                    android:text="Brightness"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF" />

                <SeekBar
                    android:id="@+id/sb_brightness"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100" />
            </LinearLayout>

            <!-- Contrast -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="wrap_content"
                    android:text="Contrast"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF" />

                <SeekBar
                    android:id="@+id/sb_contrast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="50" />
            </LinearLayout>

            <!-- Saturation -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:layout_width="74dp"
                    android:layout_height="wrap_content"
                    android:text="Saturation"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF" />

                <SeekBar
                    android:id="@+id/sb_saturation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100" />
            </LinearLayout>

        </LinearLayout>

        <!-- 3. Preset Filter Strip -->
        <HorizontalScrollView
            android:id="@+id/panel_filters"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:paddingHorizontal="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter_original"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="Original"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="#FFFFFF"
                    android:strokeColor="#55FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter_vivid"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="Vivid"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="#FFFFFF"
                    android:strokeColor="#55FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter_warm"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="Warm"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="#FFFFFF"
                    android:strokeColor="#55FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter_cool"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="Cool"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="#FFFFFF"
                    android:strokeColor="#55FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter_mono"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="Mono"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="#FFFFFF"
                    android:strokeColor="#55FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_filter_faded"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="Faded"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:textColor="#FFFFFF"
                    android:strokeColor="#55FFFFFF" />

            </LinearLayout>
        </HorizontalScrollView>

    </FrameLayout>

    <!-- Bottom Category Tabs: Crop/Transform | Adjust | Filters -->
    <LinearLayout
        android:id="@+id/edit_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#151515"
        android:elevation="6dp">

        <TextView
            android:id="@+id/tab_transform"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Transform"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:foreground="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tab_adjust"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Adjust"
            android:textSize="13sp"
            android:textColor="#888888"
            android:foreground="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tab_filters"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Filters"
            android:textSize="13sp"
            android:textColor="#888888"
            android:foreground="?attr/selectableItemBackground" />

    </LinearLayout>

</LinearLayout>
