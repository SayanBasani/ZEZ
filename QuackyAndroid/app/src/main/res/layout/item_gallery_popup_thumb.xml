<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_gallery_thumb"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_margin="2.5dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorThemeInputBg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_gallery_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Gallery item" />

        <!-- Subtle Selection Tint -->
        <View
            android:id="@+id/view_gallery_selected_dim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#55000000"
            android:visibility="gone" />

        <!-- Top-Right Multi-Select Numbered Circle -->
        <FrameLayout
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp">

            <View
                android:id="@+id/view_gallery_unselected_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_circle_white_stroke" />

            <TextView
                android:id="@+id/tv_gallery_select_number"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:background="@drawable/bg_circle_dot"
                android:backgroundTint="?attr/colorThemePrimary"
                android:text="1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Bottom-Left Video Duration Pill -->
        <LinearLayout
            android:id="@+id/layout_gallery_video_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="#99000000"
            android:visibility="gone">

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:src="@drawable/ic_video"
                app:tint="@android:color/white"
                android:layout_marginEnd="3dp" />

            <TextView
                android:id="@+id/tv_gallery_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:15"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</androidx.cardview.widget.CardView>
