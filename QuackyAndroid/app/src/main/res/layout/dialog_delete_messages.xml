<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorThemeBorder"
    app:cardBackgroundColor="?attr/colorThemeSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_dialog_delete_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete message?"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="?attr/colorThemeTextPrimary"
            android:layout_marginBottom="20dp" />

        <!-- Delete for Everyone Button -->
        <TextView
            android:id="@+id/btn_dialog_delete_everyone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical|end"
            android:text="Delete for everyone"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#EF4444"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:visibility="visible" />

        <!-- Delete for Me Button -->
        <TextView
            android:id="@+id/btn_dialog_delete_for_me"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical|end"
            android:text="Delete for me"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <!-- Cancel Button -->
        <TextView
            android:id="@+id/btn_dialog_delete_cancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical|end"
            android:text="Cancel"
            android:textSize="14sp"
            android:textColor="?attr/colorThemeTextSecondary"
            android:paddingHorizontal="16dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
