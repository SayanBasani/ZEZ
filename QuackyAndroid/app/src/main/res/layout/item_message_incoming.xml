<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:paddingHorizontal="16dp"
    android:paddingVertical="3dp">

    <LinearLayout
        android:id="@+id/layout_msg_incoming_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble_incoming"
        android:elevation="1dp"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <!-- Quoted Reply Box (Top of bubble, WhatsApp Style) -->
        <LinearLayout
            android:id="@+id/layout_msg_incoming_quote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="180dp"
            android:orientation="horizontal"
            android:background="#15000000"
            android:paddingStart="8dp"
            android:paddingEnd="6dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="6dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:minHeight="36dp"
                android:background="#22C55E"
                android:layout_marginEnd="6dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="120dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_msg_incoming_quote_sender"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact"
                    android:textStyle="bold"
                    android:textSize="11sp"
                    android:textColor="#22C55E" />

                <TextView
                    android:id="@+id/tv_msg_incoming_quote_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quoted text"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="?attr/colorThemeTextSecondary" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_msg_incoming_quote_image"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_pill_badge"
                android:clipToOutline="true"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Media Container (Image / Video) -->
        <FrameLayout
            android:id="@+id/layout_msg_incoming_media"
            android:layout_width="220dp"
            android:layout_height="180dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/iv_msg_incoming_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/iv_msg_incoming_play"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_circle"
                    app:tint="@android:color/white"
                    android:visibility="gone" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Document / File Container -->
        <LinearLayout
            android:id="@+id/layout_msg_incoming_file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/bg_circle_glass"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_document"
                app:tint="?attr/colorThemeIconTint" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tv_msg_incoming_filename"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="160dp"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:text="document.pdf"
                    android:textColor="?attr/colorThemeTextPrimary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_msg_incoming_filesize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.2 MB"
                    android:textColor="?attr/colorThemeTextMuted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Interactive Game Invite Card -->
        <LinearLayout
            android:id="@+id/layout_msg_incoming_game_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="210dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_game_invite_card"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_attach_circle_games">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_games"
                    app:tint="@android:color/white" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_msg_incoming_game_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tic Tac Toe"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorThemeTextPrimary" />

                <TextView
                    android:id="@+id/tv_msg_incoming_game_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap Join to play together"
                    android:textSize="11sp"
                    android:textColor="?attr/colorThemeTextSecondary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_msg_incoming_game_decline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_badge"
                    android:backgroundTint="#64748B"
                    android:text="Decline"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_msg_incoming_game_cta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:background="@drawable/bg_pill_badge"
                    android:backgroundTint="#10B981"
                    android:text="Join"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_msg_incoming_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incoming message text"
            android:textSize="15sp"
            android:textColor="?attr/colorThemeTextPrimary" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <ImageView
                android:id="@+id/iv_msg_incoming_starred"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_star"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_msg_incoming_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:30 AM"
                android:textSize="10sp"
                android:textColor="?attr/colorThemeTextMuted" />
        </LinearLayout>

        <!-- Reaction Badge (Incoming: bottom-left) -->
        <LinearLayout
            android:id="@+id/layout_msg_incoming_reaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="2dp"
            android:background="@drawable/bg_reaction_badge"
            android:elevation="2dp"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_msg_incoming_reaction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:text="❤️" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
