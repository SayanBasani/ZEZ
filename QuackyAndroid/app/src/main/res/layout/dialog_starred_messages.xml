<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_pill_badge"
        android:backgroundTint="?attr/colorThemeBorder" />

    <!-- Sheet Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_star"
                android:layout_marginEnd="10dp" />

            <TextView
                android:id="@+id/tv_starred_sheet_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Starred Messages"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="?attr/colorThemeTextPrimary" />

            <TextView
                android:id="@+id/tv_starred_sheet_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="?attr/colorThemeSurfaceVariant"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="0"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorThemeTextSecondary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_close_starred_sheet"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorThemeIconTint"
            android:contentDescription="Close" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorThemeBorder" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_starred_empty"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_star"
            android:alpha="0.4"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No starred messages yet"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorThemeTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Long press any message in the chat and tap the Star button to save it here for quick reference."
            android:textSize="13sp"
            android:textColor="?attr/colorThemeTextSecondary" />
    </LinearLayout>

    <!-- Starred List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_starred_messages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:nestedScrollingEnabled="true"
        android:paddingTop="8dp" />

</LinearLayout>