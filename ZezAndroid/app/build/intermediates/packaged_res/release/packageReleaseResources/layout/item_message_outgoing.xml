<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:paddingHorizontal="16dp"
    android:paddingVertical="3dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble_outgoing"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tv_msg_outgoing_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Outgoing message text"
            android:textSize="15sp"
            android:textColor="@android:color/white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tv_msg_outgoing_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10:31 AM"
                android:textSize="10sp"
                android:textColor="#CCFFFFFF" />

            <ImageView
                android:id="@+id/iv_msg_status_tick"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_check_double"
                app:tint="#CCFFFFFF" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
