<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:paddingHorizontal="16dp"
    android:paddingVertical="3dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble_incoming"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tv_msg_incoming_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incoming message text"
            android:textSize="15sp"
            android:textColor="@color/theme_text_primary" />

        <TextView
            android:id="@+id/tv_msg_incoming_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:text="10:30 AM"
            android:textSize="10sp"
            android:textColor="@color/theme_text_muted" />
    </LinearLayout>

</LinearLayout>
