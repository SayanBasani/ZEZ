<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="?attr/selectableItemBackground">

    <!-- Avatar -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="14dp">

        <ImageView
            android:id="@+id/iv_conv_avatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person"
            app:tint="@color/theme_text_secondary"
            android:background="@drawable/bg_circle_glass"
            android:padding="10dp" />

        <TextView
            android:id="@+id/tv_conv_avatar_initials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_conv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Contact Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/theme_text_primary" />

            <TextView
                android:id="@+id/tv_conv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:45 PM"
                android:textSize="11sp"
                android:textColor="@color/theme_text_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="3dp">

            <ImageView
                android:id="@+id/iv_conv_tick"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_check_double"
                app:tint="@color/theme_text_muted"
                android:visibility="gone"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/tv_conv_last_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Last message preview goes here..."
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/theme_text_secondary" />

            <TextView
                android:id="@+id/tv_conv_unread_badge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:background="@drawable/bg_badge_unread"
                android:gravity="center"
                android:text="2"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
