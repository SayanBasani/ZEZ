<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/theme_background"
    android:gravity="center"
    android:padding="32dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_alarm"
        app:tint="@color/primary"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tv_firing_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="07:00"
        android:textSize="54sp"
        android:textStyle="bold"
        android:textColor="@color/theme_text_primary" />

    <TextView
        android:id="@+id/tv_firing_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Morning Alarm"
        android:textSize="20sp"
        android:textColor="@color/theme_text_secondary"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="48dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dismiss"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Dismiss"
        android:textSize="18sp"
        app:cornerRadius="30dp"
        android:textAllCaps="false"
        app:backgroundTint="@color/call_missed"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_snooze"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Snooze (10 min)"
        android:textSize="16sp"
        app:cornerRadius="28dp"
        android:textAllCaps="false"
        android:textColor="@color/theme_text_primary"
        app:strokeColor="@color/theme_card_border" />

</LinearLayout>
