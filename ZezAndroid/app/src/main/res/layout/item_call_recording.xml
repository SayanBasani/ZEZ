<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/theme_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Contact Name, Phone, Date, Type Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Contact / Call Avatar Icon -->
            <FrameLayout
                android:id="@+id/layout_rec_avatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_mode_toggle_normal">

                <ImageView
                    android:id="@+id/iv_rec_type_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_call"
                    app:tint="@color/primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_rec_contact_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact Name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/theme_text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:id="@+id/tv_rec_direction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↙ Incoming"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#22C55E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" • "
                        android:textSize="12sp"
                        android:textColor="@color/theme_text_muted" />

                    <TextView
                        android:id="@+id/tv_rec_phone_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+91 9123456789"
                        android:textSize="12sp"
                        android:textColor="@color/theme_text_muted" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tv_rec_type_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TWING Voice"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:background="@drawable/bg_mode_toggle_normal"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp" />

                <TextView
                    android:id="@+id/tv_rec_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="21 Nov, 10:15 AM"
                    android:textSize="11sp"
                    android:textColor="@color/theme_text_muted"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/theme_border"
            android:layout_marginVertical="10dp" />

        <!-- Audio Player Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_mode_toggle_normal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <!-- Play/Pause Button -->
            <ImageButton
                android:id="@+id/btn_rec_play_pause"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chat_send_button"
                android:src="@drawable/ic_play_arrow"
                app:tint="@android:color/white"
                android:contentDescription="Play audio" />

            <!-- Seekbar and Time Container -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp">

                <SeekBar
                    android:id="@+id/sb_rec_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:max="100"
                    android:progress="0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_rec_time_current"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="00:00"
                        android:textSize="11sp"
                        android:textColor="@color/theme_text_muted" />

                    <TextView
                        android:id="@+id/tv_rec_time_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="01:24"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/theme_text_primary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Actions Row: File Size, Share, Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tv_rec_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.2 MB"
                android:textSize="11sp"
                android:textColor="@color/theme_text_muted" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Share Button -->
            <LinearLayout
                android:id="@+id/btn_rec_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_share"
                    app:tint="@color/theme_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Share"
                    android:textSize="12sp"
                    android:textColor="@color/theme_text_primary"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Delete Button -->
            <LinearLayout
                android:id="@+id/btn_rec_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:layout_marginStart="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_delete"
                    app:tint="#EF4444" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delete"
                    android:textSize="12sp"
                    android:textColor="#EF4444"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
