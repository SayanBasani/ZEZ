<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorThemeBackground"
    android:fitsSystemWindows="true">

    <!-- Top App Bar / Toolbar -->
    <LinearLayout
        android:id="@+id/layout_storage_toolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="?attr/colorThemeSurface">

        <ImageButton
            android:id="@+id/btn_storage_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/colorThemeIconTint" />

        <ImageView
            android:id="@+id/iv_storage_avatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_person" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_storage_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorThemeTextPrimary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_storage_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 B"
                android:textSize="12sp"
                android:textColor="?attr/colorThemeTextSecondary" />
        </LinearLayout>

        <!-- Delete Action (visible when items selected) -->
        <ImageButton
            android:id="@+id/btn_storage_delete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_delete"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#EF4444"
            android:visibility="gone" />

        <!-- Sort Action -->
        <ImageButton
            android:id="@+id/btn_storage_sort"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/ic_sort"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="?attr/colorThemeIconTint" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorThemeBorder" />

    <!-- Subheader Bar (SIZE filter on left, Select all on right) -->
    <LinearLayout
        android:id="@+id/layout_storage_subheader"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="?attr/colorThemeBackground">

        <TextView
            android:id="@+id/tv_storage_sort_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SIZE ▾"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorThemeTextSecondary"
            android:padding="6dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/layout_select_all"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tv_select_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select all"
                android:textSize="13sp"
                android:textColor="?attr/colorThemeTextSecondary" />

            <CheckBox
                android:id="@+id/cb_select_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:clickable="false"
                android:focusable="false" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_manage_storage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="1dp" />

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/layout_storage_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_folder"
                app:tint="?attr/colorThemeTextMuted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No media found"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/colorThemeTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Shared photos, videos, and documents will appear here."
                android:textSize="13sp"
                android:textColor="?attr/colorThemeTextSecondary"
                android:gravity="center" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
