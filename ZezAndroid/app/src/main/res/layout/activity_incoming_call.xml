<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B141A"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="90dp">

        <TextView
            android:id="@+id/tv_incoming_call_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incoming Quacky Video Call"
            android:textColor="#22C55E"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <TextView
            android:id="@+id/tv_incoming_caller_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Caller Name"
            android:textColor="@android:color/white"
            android:textSize="28sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:paddingHorizontal="24dp" />

        <TextView
            android:id="@+id/tv_incoming_caller_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="+91 1234567890"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Caller Avatar -->
        <FrameLayout
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="60dp">

            <View
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:background="@drawable/bg_circle_glass"
                android:backgroundTint="#20FFFFFF" />

            <ImageView
                android:id="@+id/iv_incoming_caller_avatar"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_person"
                app:tint="#A7F3D0" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="🔒 End-to-end encrypted call"
            android:textColor="#64748B"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Bottom Action Controls: Decline (Red) and Accept (Green) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingBottom="56dp"
        android:paddingHorizontal="48dp">

        <!-- Decline Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_incoming_decline"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_call_btn_end"
                android:src="@drawable/ic_call_end"
                app:tint="@android:color/white"
                android:contentDescription="Decline Call" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Decline"
                android:textColor="#EF4444"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Accept Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_incoming_accept"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_call_btn_accept"
                android:src="@drawable/ic_call"
                app:tint="@android:color/white"
                android:contentDescription="Accept Call" />

            <TextView
                android:id="@+id/tv_incoming_accept_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Accept"
                android:textColor="#22C55E"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>