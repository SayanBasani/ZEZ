<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    app:cardCornerRadius="6dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorThemeSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="124dp">

        <!-- Media Thumbnail -->
        <ImageView
            android:id="@+id/iv_picker_thumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Media thumbnail" />

        <!-- Top Right File Size Pill (from User Screenshot) -->
        <TextView
            android:id="@+id/tv_picker_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="#99000000"
            android:text="80 MB"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Video Duration Badge (Top Left or Bottom Left) -->
        <LinearLayout
            android:id="@+id/layout_picker_video_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="5dp"
            android:paddingVertical="2dp"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="#99000000"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_video"
                app:tint="@android:color/white"
                android:layout_marginEnd="3dp" />

            <TextView
                android:id="@+id/tv_picker_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:15"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Filename Shade & Text -->
        <View
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:background="#80000000"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_picker_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="6dp"
            android:paddingBottom="4dp"
            android:singleLine="true"
            android:ellipsize="middle"
            android:text="media_file.mp4"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Selection Check Overlay -->
        <View
            android:id="@+id/view_picker_selected_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#552563EB"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_picker_check"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="6dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/primary"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
