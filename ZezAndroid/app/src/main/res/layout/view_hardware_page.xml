<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_hardware_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorThemeBackground"
    android:visibility="gone">

    <!-- Top Futuristic Sub-Page Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="?attr/colorThemeSurface"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btn_back_hardware"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorThemeIconTint"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="System Telemetry"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="?attr/colorThemeTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hardware Diagnostics &amp; Real-time Metrics"
                android:textSize="11sp"
                android:textColor="?attr/colorThemeTextMuted" />
        </LinearLayout>

        <!-- Live Status Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="#1510B981"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_circle_primary"
                android:backgroundTint="#10B981"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ONLINE"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="#10B981" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Storage Diagnostics Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorThemeBorder"
                app:cardBackgroundColor="?attr/colorThemeSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_document"
                            app:tint="@color/primary"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Primary Flash Storage"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorThemeTextPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Internal NVMe / eMMC storage block"
                                android:textSize="11sp"
                                android:textColor="?attr/colorThemeTextMuted" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_page_storage_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progress_page_storage"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        android:progressDrawable="@android:drawable/progress_horizontal"
                        android:progress="0"
                        android:max="100" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_page_storage_details"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Used: 0 GB / Total: 0 GB"
                            android:textSize="12sp"
                            android:textColor="?attr/colorThemeTextSecondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Health: 100% OK"
                            android:textSize="11sp"
                            android:textColor="#10B981" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. RAM Diagnostics Card with Live Telemetry Graph -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorThemeBorder"
                app:cardBackgroundColor="?attr/colorThemeSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_hardware"
                            app:tint="#10B981"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="System Memory (RAM)"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorThemeTextPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Physical LPDDR cache &amp; app allocations"
                                android:textSize="11sp"
                                android:textColor="?attr/colorThemeTextMuted" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_page_ram_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="17sp"
                            android:textStyle="bold"
                            android:textColor="#10B981" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progress_page_ram"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="8dp"
                        android:progressDrawable="@android:drawable/progress_horizontal"
                        android:progress="0"
                        android:max="100" />

                    <TextView
                        android:id="@+id/tv_page_ram_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Used: 0 GB / Total: 0 GB"
                        android:textSize="12sp"
                        android:textColor="?attr/colorThemeTextSecondary"
                        android:layout_marginBottom="12dp" />

                    <!-- Live RAM Telemetry Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="REALTIME RAM TELEMETRY"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:textColor="?attr/colorThemeTextMuted" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1.5s SAMPLE"
                            android:textSize="9sp"
                            android:textColor="?attr/colorThemeTextMuted" />
                    </LinearLayout>

                    <com.zez.app.util.TelemetryGraphView
                        android:id="@+id/graph_ram_load"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:background="#0A808080" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. CPU & GPU Activity Diagnostics Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorThemeBorder"
                app:cardBackgroundColor="?attr/colorThemeSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_clock"
                            app:tint="#8B5CF6"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Compute &amp; Processing Unit"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorThemeTextPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Multi-core processor workload &amp; clocks"
                                android:textSize="11sp"
                                android:textColor="?attr/colorThemeTextMuted" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_page_cpu_load_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18% Active"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="#8B5CF6" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="DYNAMIC CORE WORKLOAD"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:textColor="?attr/colorThemeTextMuted" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="GOVERNOR: SCHEDUTIL"
                            android:textSize="9sp"
                            android:textColor="?attr/colorThemeTextMuted" />
                    </LinearLayout>

                    <!-- Live CPU/GPU Telemetry Graph -->
                    <com.zez.app.util.TelemetryGraphView
                        android:id="@+id/graph_cpu_load"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:background="#0A808080" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="?attr/colorThemeBorder"
                        android:layout_marginVertical="14dp" />

                    <!-- CPU 3-Column Metrics (Cores, Speed, ABI) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_page_cpu_cores"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="8 Cores"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorThemeTextPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CPU Cores"
                                android:textSize="11sp"
                                android:textColor="?attr/colorThemeTextMuted" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="32dp"
                            android:background="?attr/colorThemeBorder" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_page_cpu_speed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2.40 GHz"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorThemeTextPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Max Clock"
                                android:textSize="11sp"
                                android:textColor="?attr/colorThemeTextMuted" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="32dp"
                            android:background="?attr/colorThemeBorder" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_page_cpu_abi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="arm64-v8a"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorThemeTextPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Instruction Set"
                                android:textSize="11sp"
                                android:textColor="?attr/colorThemeTextMuted" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_page_cpu_hardware"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hardware: Unknown"
                        android:textSize="12sp"
                        android:textColor="?attr/colorThemeTextSecondary"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Subtle Diagnostic Line (tap 5 times within 3s to unlock Developer Server Configuration) -->
            <TextView
                android:id="@+id/tv_hardware_diagnostic_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="System Diagnostics &amp; Telemetry Integrity"
                android:textSize="11sp"
                android:textColor="?attr/colorThemeTextMuted"
                android:paddingVertical="14dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true" />

            <!-- Hidden Developer Server Connection Card (revealed on 5 taps) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_hardware_server_config"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorThemeBorder"
                app:cardBackgroundColor="?attr/colorThemeSurface"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_cloud"
                            app:tint="?attr/colorThemeIconTint"
                            android:layout_marginEnd="12dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Server Endpoint URL"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="?attr/colorThemeTextPrimary" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Configured endpoint for calls, chat, and telemetry"
                                android:textSize="12sp"
                                android:textColor="?attr/colorThemeTextSecondary" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:boxBackgroundMode="outline"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxStrokeColor="@color/primary"
                        android:hint="Backend URL"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_setting_backend_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textUri"
                            android:singleLine="true"
                            android:textSize="13sp"
                            android:textColor="?attr/colorThemeTextPrimary" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_setting_reset_url"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:text="Reset Default"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            app:strokeColor="?attr/colorThemeBorder"
                            android:textColor="?attr/colorThemeTextSecondary" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_setting_save_url"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="Save &amp; Connect"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            app:backgroundTint="@color/primary"
                            android:textColor="@android:color/white" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_setting_server_current"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textSize="11sp"
                        android:textColor="?attr/colorThemeTextMuted"
                        android:text="Active: https://zez-chat-backend.onrender.com" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
