<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/view_hardware_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/theme_background"
    android:visibility="gone">

    <!-- Top Sub-Page Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="@color/theme_app_bar"
        android:elevation="1dp">

        <ImageButton
            android:id="@+id/btn_back_hardware"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/theme_icon_tint"
            android:contentDescription="Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Storage &amp; Hardware"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_primary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Storage Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/theme_card_border"
                app:cardBackgroundColor="@color/theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Internal Storage"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/theme_text_primary" />

                        <TextView
                            android:id="@+id/tv_page_storage_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progress_page_storage"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="8dp"
                        android:progressDrawable="@android:drawable/progress_horizontal"
                        android:progress="0"
                        android:max="100" />

                    <TextView
                        android:id="@+id/tv_page_storage_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Used: 0 GB / Total: 0 GB"
                        android:textSize="12sp"
                        android:textColor="@color/theme_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- RAM Card with Live Graph -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/theme_card_border"
                app:cardBackgroundColor="@color/theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RAM Usage"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/theme_text_primary" />

                        <TextView
                            android:id="@+id/tv_page_ram_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/call_incoming" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/progress_page_ram"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="8dp"
                        android:progressDrawable="@android:drawable/progress_horizontal"
                        android:progress="0"
                        android:max="100" />

                    <TextView
                        android:id="@+id/tv_page_ram_details"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Used: 0 GB / Total: 0 GB"
                        android:textSize="12sp"
                        android:textColor="@color/theme_text_secondary"
                        android:layout_marginBottom="12dp" />

                    <!-- Live RAM Telemetry Graph -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RAM REALTIME LOAD"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/theme_text_muted"
                        android:layout_marginBottom="4dp" />

                    <com.zez.app.util.TelemetryGraphView
                        android:id="@+id/graph_ram_load"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:background="#08808080" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- CPU & GPU Load Graph Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/theme_card_border"
                app:cardBackgroundColor="@color/theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CPU &amp; GPU Activity"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/theme_text_primary" />

                        <TextView
                            android:id="@+id/tv_page_cpu_load_percent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="18% Active"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DYNAMIC PROCESSOR FREQUENCY &amp; LOAD"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:textColor="@color/theme_text_muted"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp" />

                    <!-- Live CPU/GPU Telemetry Graph -->
                    <com.zez.app.util.TelemetryGraphView
                        android:id="@+id/graph_cpu_load"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:background="#08808080" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/theme_card_border"
                        android:layout_marginVertical="14dp" />

                    <!-- CPU Metrics (Cores, Speed, ABI) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_page_cpu_cores"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="8 Cores"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/theme_text_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CPU Cores"
                                android:textSize="11sp"
                                android:textColor="@color/theme_text_muted" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="32dp"
                            android:background="@color/theme_card_border" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_page_cpu_speed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="2.40 GHz"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/theme_text_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Max Clock"
                                android:textSize="11sp"
                                android:textColor="@color/theme_text_muted" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="32dp"
                            android:background="@color/theme_card_border" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_page_cpu_abi"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="arm64-v8a"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                android:textColor="@color/theme_text_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Architecture"
                                android:textSize="11sp"
                                android:textColor="@color/theme_text_muted" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_page_cpu_hardware"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hardware: Unknown"
                        android:textSize="12sp"
                        android:textColor="@color/theme_text_secondary"
                        android:layout_marginTop="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
