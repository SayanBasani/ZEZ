<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="?attr/colorThemeSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <ProgressBar
            android:id="@+id/pb_dl_progress"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:indeterminate="true" />

        <TextView
            android:id="@+id/tv_dl_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preparing download..."
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="?attr/colorThemeTextPrimary"
            android:layout_marginTop="16dp"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your download will automatically start in the background"
            android:textSize="11sp"
            android:textColor="?attr/colorThemeTextMuted"
            android:layout_marginTop="4dp"
            android:gravity="center" />

        <!-- Hidden or 1dp WebView to process media extraction and triggers DownloadManager -->
        <WebView
            android:id="@+id/wv_downloader"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:visibility="invisible" />

        <Button
            android:id="@+id/btn_dl_close"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="?attr/colorThemeTextMuted"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
