<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_bottom_sheet_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_contact_recordings_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Call Recordings"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/theme_text_primary" />

            <TextView
                android:id="@+id/tv_contact_recordings_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recorded calls with this contact"
                android:textSize="12sp"
                android:textColor="@color/theme_text_muted"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_contact_recordings_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/theme_icon_tint"
            android:contentDescription="Close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/theme_border"
        android:layout_marginBottom="8dp" />

    <!-- RecyclerView for Recordings -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_contact_recordings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="400dp"
        android:clipToPadding="false"
        android:paddingVertical="4dp" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_contact_recordings_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/theme_text_muted" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Call Recordings"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_primary"
            android:layout_marginTop="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Normal voice calls with this contact will be recorded automatically."
            android:textSize="12sp"
            android:textColor="@color/theme_text_muted"
            android:gravity="center"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</LinearLayout>
