<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:cardCornerRadius="26dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/theme_surface"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/btn_react_thumb"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="👍"
            android:textSize="22sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_react_heart"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="❤️"
            android:textSize="22sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_react_laugh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="😂"
            android:textSize="22sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_react_surprised"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="😮"
            android:textSize="22sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_react_sad"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="😢"
            android:textSize="22sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_react_pray"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🙏"
            android:textSize="22sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_react_fire"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🔥"
            android:textSize="22sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_react_party"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="🎉"
            android:textSize="22sp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</androidx.cardview.widget.CardView>