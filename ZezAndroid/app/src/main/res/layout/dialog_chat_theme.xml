<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_badge"
        android:backgroundTint="?attr/colorThemeBorder" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Chat theme &amp; wallpaper"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="?attr/colorThemeTextPrimary"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <!-- Theme 1: Default -->
        <LinearLayout
            android:id="@+id/theme_opt_default"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">

            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_chat_theme_default">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_reaction_badge" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Default"
                android:textSize="11sp"
                android:textColor="?attr/colorThemeTextSecondary" />
        </LinearLayout>

        <!-- Theme 2: Charcoal -->
        <LinearLayout
            android:id="@+id/theme_opt_charcoal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">

            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_chat_theme_charcoal">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_reaction_badge" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Charcoal"
                android:textSize="11sp"
                android:textColor="?attr/colorThemeTextSecondary" />
        </LinearLayout>

        <!-- Theme 3: Emerald -->
        <LinearLayout
            android:id="@+id/theme_opt_emerald"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">

            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_chat_theme_emerald">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_reaction_badge" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Emerald"
                android:textSize="11sp"
                android:textColor="?attr/colorThemeTextSecondary" />
        </LinearLayout>

        <!-- Theme 4: Ocean -->
        <LinearLayout
            android:id="@+id/theme_opt_ocean"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">

            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_chat_theme_ocean">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_reaction_badge" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Ocean"
                android:textSize="11sp"
                android:textColor="?attr/colorThemeTextSecondary" />
        </LinearLayout>

        <!-- Theme 5: Sunset -->
        <LinearLayout
            android:id="@+id/theme_opt_sunset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="4dp">

            <FrameLayout
                android:layout_width="54dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_chat_theme_sunset">
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_reaction_badge" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Sunset"
                android:textSize="11sp"
                android:textColor="?attr/colorThemeTextSecondary" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorThemeBorder"
        android:layout_marginVertical="12dp" />

    <!-- Custom Wallpaper from Gallery -->
    <LinearLayout
        android:id="@+id/theme_opt_gallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@drawable/bg_pill_badge"
        android:backgroundTint="?attr/colorThemeBorder"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_photo_library"
            app:tint="@color/primary"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose from Gallery"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorThemeTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Set a custom photo as chat wallpaper"
                android:textSize="12sp"
                android:textColor="?attr/colorThemeTextSecondary" />
        </LinearLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_chevron_right"
            app:tint="?attr/colorThemeIconTint" />
    </LinearLayout>

    <!-- Wallpaper Dimming Slider (WhatsApp Style) -->
    <LinearLayout
        android:id="@+id/layout_wallpaper_dim_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Wallpaper Dimming"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="?attr/colorThemeTextPrimary" />

            <TextView
                android:id="@+id/tv_wallpaper_dim_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seek_wallpaper_dim"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:max="80"
            android:progress="0" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/colorThemeBorder"
        android:layout_marginVertical="12dp" />

    <!-- Reset to Default Wallpaper Option -->
    <LinearLayout
        android:id="@+id/theme_opt_reset_default"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@drawable/bg_pill_badge"
        android:backgroundTint="?attr/colorThemeBorder"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_refresh"
            app:tint="?attr/colorThemeIconTint"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reset to Default Wallpaper"
            android:textSize="14sp"
            android:textColor="?attr/colorThemeTextPrimary" />
    </LinearLayout>

</LinearLayout>
