<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        android:background="?attr/colorThemeBorder" />

    <!-- Top Header Bar (Album Selector + Selected Count + Close) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp">

        <LinearLayout
            android:id="@+id/layout_gallery_album_picker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:id="@+id/tv_gallery_album_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recent"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="?attr/colorThemeTextPrimary" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_expand_more"
                app:tint="?attr/colorThemeTextPrimary" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_gallery_selected_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="?attr/colorThemePrimary"
            android:text="0 selected"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_gallery_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorThemeTextPrimary"
            android:contentDescription="Close gallery" />
    </LinearLayout>

    <!-- Row 1: Media Type Filter & Folder Fallback -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/chip_gallery_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="?attr/colorThemePrimary"
            android:text="All"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/chip_gallery_photos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="?attr/colorThemeInputBg"
            android:text="Photos"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorThemeTextSecondary" />

        <TextView
            android:id="@+id/chip_gallery_videos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:background="@drawable/bg_pill_badge"
            android:backgroundTint="?attr/colorThemeInputBg"
            android:text="Videos"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorThemeTextSecondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btn_gallery_system_fallback"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:text="Folders"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorThemePrimary"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <!-- Row 2: View Style (By Date vs Normal) & Date Filter -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/chip_view_by_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="?attr/colorThemePrimary"
                android:text="By Date"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/chip_view_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="?attr/colorThemeInputBg"
                android:text="Normal Grid"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorThemeTextSecondary" />

            <TextView
                android:id="@+id/btn_gallery_date_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="?attr/colorThemeInputBg"
                android:text="All Dates ▾"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorThemeTextPrimary" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Grid Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="280dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_gallery_popup"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="4dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/progress_gallery_popup"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center" />

        <TextView
            android:id="@+id/tv_gallery_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp"
            android:gravity="center"
            android:text="No photos or videos found for selected filter"
            android:textSize="14sp"
            android:textColor="?attr/colorThemeTextMuted"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom Caption + Multi-Send Bar (WhatsApp style) -->
    <LinearLayout
        android:id="@+id/layout_gallery_send_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp"
        android:background="?attr/colorThemeSurfaceVariant"
        android:visibility="gone">

        <EditText
            android:id="@+id/et_gallery_caption"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/bg_gallery_caption_bar"
            android:hint="Add a caption..."
            android:textColorHint="?attr/colorThemeTextMuted"
            android:textColor="?attr/colorThemeTextPrimary"
            android:textSize="14sp"
            android:maxLines="3"
            android:inputType="textCapSentences|textMultiLine" />

        <FrameLayout
            android:id="@+id/btn_gallery_send"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_attach_circle_games"
            android:backgroundTint="?attr/colorThemePrimary"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_send"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tv_gallery_send_badge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="2dp"
                android:gravity="center"
                android:background="@drawable/bg_circle_dot"
                android:backgroundTint="#111827"
                android:text="1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
