<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Chat Profile &amp; Settings"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_primary" />

        <ImageButton
            android:id="@+id/btn_close_profile_dialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/theme_icon_tint"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Avatar with Edit Badge -->
    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_profile_avatar"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_person"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.LargeComponent"
            android:background="@color/theme_surface"
            app:strokeColor="@color/primary"
            app:strokeWidth="2dp" />

        <FrameLayout
            android:id="@+id/btn_profile_change_photo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom|end"
            android:background="@drawable/bg_circle_glass"
            android:backgroundTint="@color/primary">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_camera"
                app:tint="@android:color/white" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="Tap camera icon to change photo"
        android:textSize="11sp"
        android:textColor="@color/theme_text_muted"
        android:layout_marginBottom="16dp" />

    <!-- Registered Phone Number -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Registered Phone Number"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/theme_text_secondary"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_search_input"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tv_profile_phone_val"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="+91 9876543210"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_primary" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_check_circle"
            app:tint="@color/primary" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your phone number is used for Zez 1-on-1 messaging."
        android:textSize="11sp"
        android:textColor="@color/theme_text_muted"
        android:layout_marginBottom="14dp" />

    <!-- Name Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your Name"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/theme_text_secondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_profile_name_val"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_search_input"
        android:paddingHorizontal="12dp"
        android:textSize="15sp"
        android:textColor="@color/theme_text_primary"
        android:singleLine="true"
        android:layout_marginBottom="14dp" />

    <!-- Status / About Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="About"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/theme_text_secondary"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/et_profile_status_val"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_search_input"
        android:paddingHorizontal="12dp"
        android:textSize="15sp"
        android:textColor="@color/theme_text_primary"
        android:singleLine="true"
        android:layout_marginBottom="20dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_cancel_profile"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/theme_text_secondary" />

        <Button
            android:id="@+id/btn_save_profile"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
