<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="?attr/colorThemeSurface">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="520dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Download Media"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="?attr/colorThemeTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Choose your preferred audio or video format"
                android:textSize="12sp"
                android:textColor="?attr/colorThemeTextMuted"
                android:layout_marginTop="2dp" />

            <!-- Song preview card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_search_input"
                android:padding="10dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/iv_download_thumb"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />
                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tv_download_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Song Title"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="?attr/colorThemeTextPrimary"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/tv_download_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Artist"
                        android:textSize="12sp"
                        android:textColor="?attr/colorThemeTextMuted"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- File Name Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="File Name"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorThemeTextSecondary"
                android:layout_marginTop="14dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_search_input"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_edit"
                    app:tint="?attr/colorThemeTextMuted" />

                <EditText
                    android:id="@+id/et_download_filename"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@null"
                    android:hint="File name"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:textColor="?attr/colorThemeTextPrimary"
                    android:textColorHint="?attr/colorThemeTextMuted" />
            </LinearLayout>

            <!-- Format Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Audio / Video Format"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorThemeTextSecondary"
                android:layout_marginTop="14dp" />

            <RadioGroup
                android:id="@+id/rg_download_format"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp">

                <!-- Audio Rungs -->
                <RadioButton
                    android:id="@+id/rb_format_m4a"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎵 Audio · M4A (256 kbps AAC Fast)"
                    android:textSize="13sp"
                    android:textColor="?attr/colorThemeTextPrimary"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/rb_format_mp3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎵 Audio · MP3 (320 kbps HQ Audio)"
                    android:textSize="13sp"
                    android:textColor="?attr/colorThemeTextPrimary"
                    android:checked="true"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/rb_format_mp3_std"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎵 Audio · MP3 (128 kbps Standard)"
                    android:textSize="13sp"
                    android:textColor="?attr/colorThemeTextPrimary"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/rb_format_opus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎵 Audio · OPUS (160 kbps WebM Audio)"
                    android:textSize="13sp"
                    android:textColor="?attr/colorThemeTextPrimary"
                    android:paddingVertical="4dp" />

                <!-- Video Rungs -->
                <RadioButton
                    android:id="@+id/rb_format_mp4_1080"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎬 Video · MP4 1080p (Full HD)"
                    android:textSize="13sp"
                    android:textColor="?attr/colorThemeTextPrimary"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/rb_format_mp4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎬 Video · MP4 720p (HD Video)"
                    android:textSize="13sp"
                    android:textColor="?attr/colorThemeTextPrimary"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/rb_format_mp4_480"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎬 Video · MP4 480p (Standard)"
                    android:textSize="13sp"
                    android:textColor="?attr/colorThemeTextPrimary"
                    android:paddingVertical="4dp" />

                <RadioButton
                    android:id="@+id/rb_format_mp4_360"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🎬 Video · MP4 360p (Fast Saver)"
                    android:textSize="13sp"
                    android:textColor="?attr/colorThemeTextPrimary"
                    android:paddingVertical="4dp" />
            </RadioGroup>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="16dp">

                <Button
                    android:id="@+id/btn_download_cancel"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel"
                    android:textColor="?attr/colorThemeTextMuted" />

                <Button
                    android:id="@+id/btn_download_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Download"
                    android:backgroundTint="@color/primary"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.cardview.widget.CardView>
