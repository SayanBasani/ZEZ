<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="@color/theme_surface">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Alarm"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/theme_text_primary"
        android:layout_marginBottom="16dp" />

    <!-- TimePicker (Clock/Spinner) -->
    <TimePicker
        android:id="@+id/time_picker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:timePickerMode="spinner"
        android:layout_gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Alarm Label Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Alarm Label"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="14dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_alarm_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="Alarm" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Ringtone Selector Row -->
    <LinearLayout
        android:id="@+id/row_select_ringtone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="?attr/selectableItemBackground"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alarm Ringtone"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/theme_text_primary" />

            <TextView
                android:id="@+id/tv_selected_ringtone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Default Alarm Ringtone"
                android:textSize="12sp"
                android:textColor="@color/theme_text_secondary" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />
    </LinearLayout>

    <!-- Vibrate Toggle Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vibrate"
            android:textSize="14sp"
            android:textColor="@color/theme_text_primary" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_vibrate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true" />
    </LinearLayout>

    <!-- Repeat Days Selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Repeat Days"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/theme_text_muted"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="7"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <ToggleButton
            android:id="@+id/tb_sun"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:textOn="S"
            android:textOff="S"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ToggleButton
            android:id="@+id/tb_mon"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:textOn="M"
            android:textOff="M"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ToggleButton
            android:id="@+id/tb_tue"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:textOn="T"
            android:textOff="T"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ToggleButton
            android:id="@+id/tb_wed"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:textOn="W"
            android:textOff="W"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ToggleButton
            android:id="@+id/tb_thu"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:textOn="T"
            android:textOff="T"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ToggleButton
            android:id="@+id/tb_fri"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:textOn="F"
            android:textOff="F"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ToggleButton
            android:id="@+id/tb_sat"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_margin="2dp"
            android:textOn="S"
            android:textOff="S"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Dialog Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_dialog_delete"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Delete"
            android:textColor="@color/call_missed"
            android:textAllCaps="false"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btn_dialog_cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/theme_text_secondary"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_dialog_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Alarm"
            android:textAllCaps="false"
            android:layout_marginStart="8dp" />
    </LinearLayout>

</LinearLayout>
</androidx.core.widget.NestedScrollView>
