<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/theme_background">

    <!-- Top WhatsApp-Style Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="4dp"
        android:background="@color/theme_surface"
        android:elevation="2dp">

        <ImageButton
            android:id="@+id/btn_chat_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/theme_icon_tint"
            android:contentDescription="Back" />

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="10dp">

            <ImageView
                android:id="@+id/iv_chat_header_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_person"
                app:tint="@color/theme_text_secondary"
                android:background="@drawable/bg_circle_glass"
                android:padding="6dp" />

            <TextView
                android:id="@+id/tv_chat_header_initials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_chat_header_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Contact Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/theme_text_primary" />

            <TextView
                android:id="@+id/tv_chat_header_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="online"
                android:textSize="11sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/primary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_chat_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/theme_icon_tint"
            android:contentDescription="Options" />
    </LinearLayout>

    <!-- Message Stream -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_chat_messages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp" />

    <!-- Bottom Message Input Bar (WhatsApp Style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@color/theme_surface">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_input"
            android:paddingStart="14dp"
            android:paddingEnd="6dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="8dp">

            <EditText
                android:id="@+id/et_chat_message_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Message"
                android:textColorHint="@color/theme_text_secondary"
                android:textColor="@color/theme_text_primary"
                android:textSize="15sp"
                android:maxLines="5"
                android:inputType="textMultiLine|textCapSentences" />

            <ImageButton
                android:id="@+id/btn_chat_attach"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_attach_file"
                app:tint="@color/theme_icon_tint"
                android:contentDescription="Attach file" />
        </LinearLayout>

        <!-- Circular WhatsApp Send Button -->
        <FrameLayout
            android:id="@+id/btn_chat_send_container"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_circle_glass"
            android:backgroundTint="@color/primary">

            <ImageView
                android:id="@+id/btn_chat_send"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_send"
                app:tint="@android:color/white"
                android:contentDescription="Send" />

            <ProgressBar
                android:id="@+id/pb_chat_sending"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
