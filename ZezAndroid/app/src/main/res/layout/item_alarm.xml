<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/theme_card_border"
    app:cardBackgroundColor="@color/theme_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Time Display -->
            <LinearLayout
                android:id="@+id/layout_alarm_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="bottom">

                <TextView
                    android:id="@+id/tv_alarm_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="07:00"
                    android:textSize="38sp"
                    android:textStyle="bold"
                    android:textColor="@color/theme_text_primary" />

                <TextView
                    android:id="@+id/tv_alarm_ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AM"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/theme_text_secondary"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="6dp" />
            </LinearLayout>

            <!-- On/Off Switch -->
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_alarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Subtitle: Label, Days & Ringtone -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/tv_alarm_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Morning Alarm"
                android:textSize="13sp"
                android:textColor="@color/theme_text_secondary" />

            <TextView
                android:id="@+id/tv_alarm_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mon - Fri"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_alarm_ringtone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Default Alarm Ringtone"
            android:textSize="11sp"
            android:textColor="@color/theme_text_muted"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_alarm_jit_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ JIT MODE (RELENTLESS)"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_badge_jit"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_marginTop="6dp"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
