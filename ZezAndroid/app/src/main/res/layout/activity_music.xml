<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <!-- Top App Bar -->
    <LinearLayout
        android:id="@+id/app_bar_music"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:background="@color/theme_surface"
        android:elevation="3dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btn_music_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/theme_icon_tint"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YMusic"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/theme_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Music"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:background="@drawable/bg_mode_toggle_active"
                    android:backgroundTint="#FF0000"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stream, Search &amp; Download"
                android:textSize="11sp"
                android:textColor="@color/theme_text_muted"
                android:layout_marginTop="1dp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_music_search_toggle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_search"
            app:tint="@color/theme_icon_tint"
            android:contentDescription="Search" />
    </LinearLayout>

    <!-- Search Input Box Container -->
    <LinearLayout
        android:id="@+id/layout_music_search_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="@color/theme_surface"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/app_bar_music">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search_input"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_search"
                app:tint="@color/theme_text_muted" />

            <EditText
                android:id="@+id/et_music_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@null"
                android:hint="Search songs, artists, albums..."
                android:textSize="14sp"
                android:textColor="@color/theme_text_primary"
                android:textColorHint="@color/theme_text_muted"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/btn_music_search_clear"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="@color/theme_text_muted"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Category Chips Row -->
    <HorizontalScrollView
        android:id="@+id/scroll_music_categories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/layout_music_search_box">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_cat_trending"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="Trending"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_mode_toggle_active"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_cat_top_tracks"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="Top Tracks"
                android:textSize="12sp"
                android:textColor="@color/theme_text_secondary"
                android:background="@drawable/bg_mode_toggle_normal"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_cat_recommended"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="Recommended"
                android:textSize="12sp"
                android:textColor="@color/theme_text_secondary"
                android:background="@drawable/bg_mode_toggle_normal"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_cat_charts"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="Charts"
                android:textSize="12sp"
                android:textColor="@color/theme_text_secondary"
                android:background="@drawable/bg_mode_toggle_normal"
                android:paddingHorizontal="14dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip_cat_downloads"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="📥 Downloads"
                android:textSize="12sp"
                android:textColor="@color/theme_text_secondary"
                android:background="@drawable/bg_mode_toggle_normal"
                android:paddingHorizontal="14dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/scroll_music_categories"
        app:layout_constraintBottom_toTopOf="@id/card_mini_player">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_music"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_music_tracks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="16dp" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Suggestions Dropdown List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_music_suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/theme_surface"
            android:elevation="6dp"
            android:visibility="gone" />

        <!-- Loading Indicator -->
        <ProgressBar
            android:id="@+id/pb_music_loading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Empty State View -->
        <LinearLayout
            android:id="@+id/layout_music_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_music"
                app:tint="@color/theme_text_muted" />

            <TextView
                android:id="@+id/tv_music_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No tracks found"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/theme_text_primary"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/tv_music_empty_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Try searching for another artist or song"
                android:textSize="13sp"
                android:textColor="@color/theme_text_muted"
                android:layout_marginTop="4dp"
                android:gravity="center" />
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom Mini Player -->
    <include
        layout="@layout/view_music_mini_player"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
