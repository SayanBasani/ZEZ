<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:paddingHorizontal="16dp"
    android:paddingVertical="3dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:orientation="vertical"
        android:background="@drawable/bg_bubble_incoming"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <!-- Media Container (Image / Video) -->
        <FrameLayout
            android:id="@+id/layout_msg_incoming_media"
            android:layout_width="220dp"
            android:layout_height="180dp"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="8dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/iv_msg_incoming_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/iv_msg_incoming_play"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play_circle"
                    app:tint="@android:color/white"
                    android:visibility="gone" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <!-- Document / File Container -->
        <LinearLayout
            android:id="@+id/layout_msg_incoming_file"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp"
            android:background="@drawable/bg_circle_glass"
            android:layout_marginBottom="4dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_document"
                app:tint="@color/theme_icon_tint" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tv_msg_incoming_filename"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="160dp"
                    android:singleLine="true"
                    android:ellipsize="middle"
                    android:text="document.pdf"
                    android:textColor="@color/theme_text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_msg_incoming_filesize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.2 MB"
                    android:textColor="@color/theme_text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_msg_incoming_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Incoming message text"
            android:textSize="15sp"
            android:textColor="@color/theme_text_primary" />

        <TextView
            android:id="@+id/tv_msg_incoming_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:text="10:30 AM"
            android:textSize="10sp"
            android:textColor="@color/theme_text_muted" />
    </LinearLayout>

</LinearLayout>
