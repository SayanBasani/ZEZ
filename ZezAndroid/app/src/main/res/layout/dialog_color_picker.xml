<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet"
    android:padding="20dp">

    <!-- Header Drag Bar & Title -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_pill_badge" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Full-Spectrum Color Studio"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/theme_text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Customize outgoing accents or incoming message bubbles"
        android:textSize="12sp"
        android:textColor="@color/theme_text_secondary"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="16dp" />

    <!-- Mode Toggle: Outgoing Accent vs Incoming Bubble -->
    <RadioGroup
        android:id="@+id/rg_color_target"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        android:gravity="center">

        <RadioButton
            android:id="@+id/rb_target_outgoing"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Outgoing / Accent"
            android:textSize="13sp"
            android:checked="true"
            android:textColor="@color/theme_text_primary" />

        <RadioButton
            android:id="@+id/rb_target_incoming"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Incoming Bubble"
            android:textSize="13sp"
            android:textColor="@color/theme_text_primary" />
    </RadioGroup>

    <!-- Live Preview Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_search_input"
        android:padding="14dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIVE PREVIEW"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/theme_text_muted"
            android:letterSpacing="0.08"
            android:layout_marginBottom="8dp" />

        <FrameLayout
            android:id="@+id/preview_bubble_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/preview_bubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:orientation="vertical"
                android:background="@drawable/bg_bubble_outgoing"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="6dp">

                <TextView
                    android:id="@+id/tv_preview_bubble_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello! This is a preview bubble 🚀"
                    android:textSize="14sp"
                    android:textColor="@android:color/white" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tv_preview_bubble_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10:45 AM"
                        android:textSize="10sp"
                        android:textColor="#CCFFFFFF" />

                    <ImageView
                        android:id="@+id/iv_preview_bubble_tick"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_check_double"
                        app:tint="#34B7F1" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- Spectrum Controls -->
    <!-- 1. Hue Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="Hue"
            android:textSize="13sp"
            android:textColor="@color/theme_text_secondary" />

        <SeekBar
            android:id="@+id/sb_hue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="360"
            android:progress="220" />
    </LinearLayout>

    <!-- 2. Saturation Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="Saturation"
            android:textSize="13sp"
            android:textColor="@color/theme_text_secondary" />

        <SeekBar
            android:id="@+id/sb_saturation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="80" />
    </LinearLayout>

    <!-- 3. Value / Lightness Slider -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="Brightness"
            android:textSize="13sp"
            android:textColor="@color/theme_text_secondary" />

        <SeekBar
            android:id="@+id/sb_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="100"
            android:progress="90" />
    </LinearLayout>

    <!-- Hex Input Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <View
            android:id="@+id/view_current_color_swatch"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_primary"
            android:backgroundTint="#2563EB"
            android:layout_marginEnd="12dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_hex_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Hex Color (#RRGGBB)"
                android:text="#2563EB"
                android:inputType="textCapCharacters"
                android:maxLength="9"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Quick Presets -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRESET PALETTE"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/theme_text_muted"
        android:layout_marginBottom="8dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:id="@+id/layout_preset_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <!-- Bottom Buttons: Reset, Cancel, Apply -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/btn_picker_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset Default"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/theme_text_secondary"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_picker_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textColor="@color/theme_text_secondary"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_picker_apply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Apply Color"
            android:backgroundTint="@color/primary"
            android:textColor="@android:color/white" />
    </LinearLayout>

</LinearLayout>
