<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="14dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/tv_gallery_date_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Today"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/colorThemeTextPrimary" />

    <TextView
        android:id="@+id/tv_gallery_date_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:background="@drawable/bg_pill_badge"
        android:backgroundTint="?attr/colorThemeInputBg"
        android:text="0"
        android:textSize="11sp"
        android:textColor="?attr/colorThemeTextSecondary" />
</LinearLayout>
