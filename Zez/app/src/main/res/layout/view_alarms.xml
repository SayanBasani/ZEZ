<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_alarms_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorThemeBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Quick Select Entry Header -->
        <LinearLayout
            android:id="@+id/layout_alarms_quick_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/tv_alarms_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hold any alarm or tap Select to manage"
                android:textSize="12sp"
                android:textColor="?attr/colorThemeTextSecondary" />

            <TextView
                android:id="@+id/btn_alarms_enter_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="?attr/colorThemeInputBg"
                android:text="Select"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorThemePrimary" />
        </LinearLayout>

        <!-- Multi-Select Action Bar -->
        <LinearLayout
            android:id="@+id/layout_alarms_selection_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:background="?attr/colorThemeSurfaceVariant"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_alarms_sel_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorThemeTextPrimary"
                android:contentDescription="Cancel selection" />

            <TextView
                android:id="@+id/tv_alarms_sel_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="0 selected"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/colorThemeTextPrimary" />

            <TextView
                android:id="@+id/btn_alarms_sel_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="?attr/colorThemeInputBg"
                android:text="All"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="?attr/colorThemeTextPrimary" />

            <TextView
                android:id="@+id/btn_alarms_sel_on"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="#10B981"
                android:text="Turn On"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/btn_alarms_sel_off"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="#F59E0B"
                android:text="Turn Off"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />

            <TextView
                android:id="@+id/btn_alarms_sel_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp"
                android:background="@drawable/bg_pill_badge"
                android:backgroundTint="#EF4444"
                android:text="Delete"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_alarms"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="6dp"
            android:paddingBottom="88dp"
            android:clipToPadding="false"
            android:scrollbars="vertical" />
    </LinearLayout>

    <!-- Empty Alarms State -->
    <LinearLayout
        android:id="@+id/layout_alarms_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_alarm"
            app:tint="?attr/colorThemeTextMuted"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No alarms set"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/colorThemeTextPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap the + button to add your first alarm"
            android:textSize="13sp"
            android:textColor="?attr/colorThemeTextSecondary"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Floating Action Button for Adding New Alarm -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_alarm"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="24dp"
        android:src="@android:drawable/ic_input_add"
        app:tint="?attr/colorThemeSurface"
        app:backgroundTint="@color/primary"
        android:contentDescription="Add Alarm" />

</FrameLayout>
