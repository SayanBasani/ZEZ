<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorThemeBackground"
    android:orientation="vertical">

    <!-- Shared Top Bar (Hidden when YMusic renders its own header in Step 3; clean title for utility tabs) -->
    <LinearLayout
        android:id="@+id/layout_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorThemeAppBar"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp"
        android:paddingVertical="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_header_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YMusic"
                android:textColor="?attr/colorThemeTextPrimary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_header_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Stream, Search &amp; Download"
                android:textColor="?attr/colorThemeTextSecondary"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4-Tab Content Container -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- TAB 1: MUSIC (Default Home Tab - YMusic) -->
        <FrameLayout
            android:id="@+id/view_music_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <include layout="@layout/view_music_tab" />
        </FrameLayout>

        <!-- TAB 2: ALARMS (Full Alarms module wired in Step 4) -->
        <FrameLayout
            android:id="@+id/view_alarms_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <include layout="@layout/view_alarms" />
        </FrameLayout>

        <!-- TAB 3: GALLERY (Full Gallery + PDF/PPT Studio wired in Step 5) -->
        <FrameLayout
            android:id="@+id/view_gallery_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <include layout="@layout/view_gallery" />
        </FrameLayout>

        <!-- TAB 4: SETTINGS -->
        <FrameLayout
            android:id="@+id/view_settings_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <include layout="@layout/view_settings" />
        </FrameLayout>

        <!-- SUB-PAGE: APPEARANCE -->
        <include layout="@layout/view_appearance_page" />

        <!-- SUB-PAGE: FONT -->
        <include layout="@layout/view_font_page" />

        <!-- SUB-PAGE: HARDWARE -->
        <include layout="@layout/view_hardware_page" />
    </FrameLayout>

    <!-- Persistent Cross-Tab Mini-Player Dock -->
    <FrameLayout
        android:id="@+id/layout_main_mini_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/view_music_mini_player" />
    </FrameLayout>

    <!-- Bottom 4-Tab Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorThemeNavBg"
        app:itemIconTint="?attr/colorThemePrimary"
        app:itemTextColor="?attr/colorThemePrimary"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>
