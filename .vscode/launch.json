{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Android App on Emulator / Device",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "Build & Run Android App"
    },
    {
      "name": "Debug Backend (Node.js)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/Zez-Backend/src/server.js",
      "cwd": "${workspaceFolder}/Zez-Backend",
      "restart": true,
      "console": "integratedTerminal"
    }
  ]
}
